{
  "name": "opencodekit-agent",
  "version": "0.3.1",
  "description": "A provider-neutral, permission-aware AI coding agent for your terminal",
  "type": "module",
  "license": "MIT",
  "author": "zynx-real",
  "homepage": "https://github.com/zynx-real/opencodekit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zynx-real/opencodekit.git"
  },
  "bugs": {
    "url": "https://github.com/zynx-real/opencodekit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opencodekit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepublishOnly": "npm run verify",
    "verify": "npm run format && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "cli",
    "mcp"
  ],
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.97",
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/azure": "^4.0.82",
    "@ai-sdk/cerebras": "^3.0.57",
    "@ai-sdk/cohere": "^4.0.50",
    "@ai-sdk/deepinfra": "^3.0.57",
    "@ai-sdk/fireworks": "^3.0.60",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/groq": "^4.0.50",
    "@ai-sdk/mcp": "^2.0.60",
    "@ai-sdk/mistral": "^4.0.52",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/perplexity": "^5.0.0",
    "@ai-sdk/togetherai": "^3.0.58",
    "@ai-sdk/xai": "^5.0.10",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ai": "^7.0.116",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "env-paths": "^4.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
